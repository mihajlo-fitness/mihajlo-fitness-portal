# Kopiraj ovaj fajl u .env.local (lokalno) i u Vercel → Settings →
# Environment Variables (za pravi sajt). .env.local se NE otprema na
# GitHub (već je u .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://tvoj-projekat.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tvoj-anon-public-key

# SERVICE ROLE ključ — NIKAD sa NEXT_PUBLIC_ prefiksom, ovo je tajni ključ
# koji zaobilazi sva RLS pravila. Koristi se SAMO u dve server-side cron
# rute (keep-alive, weekly-reminder). Nađeš ga u Supabase dashboard →
# Settings → API → service_role key (kliknuti "Reveal").
SUPABASE_SERVICE_ROLE_KEY=tvoj-service-role-key

# Pravi domen sajta kad ga povežeš (koristi se za sitemap/robots/OG).
# Dok ga nemaš, ostavi prazno — koristiće se mihajlofitness.fit kao podrazumevano.
NEXT_PUBLIC_SITE_URL=https://mihajlofitness.fit

# Email obaveštenja (resend.com, besplatan nalog).
# Bez ovoga aplikacija normalno radi, samo bez email obaveštenja.
RESEND_API_KEY=re_tvoj_api_kljuc
