# Kopiraj ovaj fajl u .env.local i popuni svojim podacima.
# .env.local se NE otprema na GitHub (već je u .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://tvoj-projekat.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tvoj-anon-public-key

# Lozinka za pristup Trenerskom pregledu (/trener).
# NIJE javna (bez NEXT_PUBLIC_ prefiksa) - dostupna je samo serveru,
# nikad se ne šalje klijentu u browser.
COACH_PASSWORD=izaberi-svoju-tajnu-lozinku

# Email obaveštenja (resend.com, besplatan nalog).
# Bez ovoga aplikacija normalno radi, samo bez email obaveštenja.
RESEND_API_KEY=re_tvoj_api_kljuc
